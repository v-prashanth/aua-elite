# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
# Project URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key (safe to expose in browser, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key

# Service Role key (NEVER expose in browser — server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key


# ─── Email (existing) ─────────────────────────────────────────────────────────
# Gmail account for sending contact form emails
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
CONTACT_EMAIL_TO=recipient@aquaelitesolutions.in
